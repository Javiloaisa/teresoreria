# Copia este fichero a .env y rellena los valores. El .env NO va al repositorio.

# Contraseña de la base de datos (invéntate una larga).
DB_PASSWORD=pon-una-contrasena-larga-aqui

# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=pega-aqui-una-clave-larga-y-aleatoria

# Cookie solo por HTTPS. En producción déjalo en 1 (el Caddy frontal da HTTPS).
# Ponlo a 0 solo para desarrollo en local sobre http://localhost.
COOKIE_SECURE=1

# Zona horaria: de ella dependen el "hoy" del formulario y el corte de mes.
TZ=Europe/Madrid

# --- Solo para desarrollo en local (fuera de Docker) ---
# En Docker la compone docker-compose.yml sola; aquí se apunta al túnel SSH:
#   ssh -i ~/.ssh/hetzner_deploy -L 55432:127.0.0.1:5432 root@178.104.99.197 -N
# DATABASE_URL=postgres://teresoreria:CLAVE@127.0.0.1:55432/teresoreria_dev

# --- Notificaciones push (F3, todavía sin usar) ---
# Genera el par con: cd api && python gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
